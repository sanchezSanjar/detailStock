<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/home.css" />
<!-- <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.js"></script> -->
<body class="home-body">
    <video class="bg-video" autoplay muted loop playsinline>
      <source src="/video/detailStock-ads.mp4" type="video/mp4" />
    </video>

    <div class="home-container">

    <nav class="navbar">
      <ul class="nav">

        <li class="nav-item">
          <a class="nav-link active" href="/admin">Home</a>
        </li>

        <% if(!member) { %>

        <li class="nav-item">
          <a class="nav-link" href="/admin/signup">Signup</a>
        </li>

        <li class="nav-item">
          <a class="nav-link" href="/admin/login">Login</a>
        </li>

        <% } else { %>

        <li class="nav-item">
          <a class="nav-link" href="/admin/product/all">Menu</a>
        </li>

        <li class="nav-item">
          <a class="nav-link" href="/admin/user/all">Users</a>
        </li>

        <li class="nav-item">
          <a
            class="nav-link logout"
            href="/admin/logout"
            onclick="return confirm('Do you want to logout?')"
          >
            Logout
          </a>
        </li>

        <% } %>

      </ul>
    </nav>




</div>

 <script type="text/javascript" src="/js/home.js"></script>
 <script src="/js/main.js"></script>
</body>




 





<%- include('includes/footer') %>
