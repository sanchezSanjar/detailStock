<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/users.css" />

<body>
    <div class="users-container">

        <nav class="navbar">
            <ul class="nav">
                <li class="nav-item">
                    <a class="nav-link" href="/admin">Home</a>
                </li>

                <% if(!member) { %>
                    <li class="nav-item">
                        <a class="nav-link" href="/admin/signup">Signup</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/admin/login">Login</a>
                    </li>
                <% } else { %>
                    <li class="nav-item">
                        <a class="nav-link" href="/admin/product/all">Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/admin/user/all">Users</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link logout" href="/admin/logout"
                           onclick="return confirm('Do you want to logout?')">
                            Logout
                        </a>
                    </li>
                <% } %>
            </ul>
        </nav>

        <% if(!member) { %>

            <div class="users-frame">
                <span class="please-login">Please login first!</span>
            </div>

        <% } else { %>

            <div class="users-frame">
                <div class="board">

                    <span class="page-title">ALL USERS</span>

                    <div class="table-wrapper">
                        <table>
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>NAME</th>
                                    <th>PHONE</th>
                                    <th>STATUS</th>
                                    <!-- <th>SAVE</th>
                                    <th>DELETE</th> -->
                                </tr>
                            </thead>
                            <tbody>
                                <% if (users && users.length > 0) { %>
                                    <% users.forEach((value, index) => { %>
                                        <tr class="user-row">
                                            <td><%= index + 1 %></td>

                                            <td>
                                                <input type="text" class="table-input"
                                                       data-field="memberNick"
                                                       value="<%= value.memberNick %>">
                                            </td>

                                            <td>
                                                <input type="text" class="table-input"
                                                       data-field="memberPhone"
                                                       value="<%= value.memberPhone %>">
                                            </td>

                                            <td>
                                                <select class="table-select" data-field="memberStatus">
                                                    <option value="ACTIVE" <%= value.memberStatus === "ACTIVE" ? "selected" : "" %>>ACTIVE</option>
                                                    <option value="BLOCK" <%= value.memberStatus === "BLOCK" ? "selected" : "" %>>BLOCK</option>
                                                    <option value="DELETE" <%= value.memberStatus === "DELETE" ? "selected" : "" %>>DELETE</option>
                                                </select>
                                            </td>

                                            <td>
                                                <button type="button" class="save-button user-save"
                                                        data-user-id="<%= value._id %>">
                                                    SAVE
                                                </button>
                                            </td>
                                              <td>
                                                <button type="button" class="delete-button user-delete"
                                                        data-user-id="<%= value._id %>">
                                                    DELETE
                                                </button>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="empty-users">No users found.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        <% } %>

    </div>

    <script type="text/javascript" src="/js/users.js"></script>
</body>

<%- include('includes/footer') %>